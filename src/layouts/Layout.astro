---
import '../styles/global.css';

const {
  title = 'y0konad | Ciberseguridad, Redes y Desarrollo Web',
  description = 'Portafolio de y0konad (Dan Ramos Reynaldo) — Egresado de ciberseguridad y desarrollador web en Perú. Proyectos de redes, Linux, Python, herramientas y write-ups de hacking ético.',
  path = '/',
  image = '/picture/avatars/yokonad.webp',
  type = 'website',
} = Astro.props;
const SITE = 'https://yokonad.online';
const canonical = SITE + path;
// URL absoluta de la imagen social (acepta ruta relativa o URL completa)
const ogImage = image.startsWith('http') ? image : SITE + image;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'y0konad',
  alternateName: 'Dan Ramos Reynaldo',
  url: 'https://yokonad.online/',
  image: 'https://yokonad.online/picture/avatars/yokonad.webp',
  jobTitle: 'Egresado de Ciberseguridad y Desarrollador Web',
  sameAs: ['https://github.com/y0konad', 'https://www.instagram.com/yk.nadrr/'],
};
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="y0konad, portafolio y0konad, ciberseguridad, desarrollo web, React, Python, Linux, redes, SENATI"
    />
    <meta name="author" content="y0konad" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Rubik+Mono+One&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#020408" />
    <link rel="icon" href="/picture/logos/linux.ico" />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
