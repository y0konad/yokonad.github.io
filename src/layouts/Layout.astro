---
import '../styles/global.css';
import AsciiSharks from '../components/AsciiSharks.jsx';

const {
  title = 'y0konad | Ciberseguridad, Redes y Desarrollo Web',
  description = 'Portafolio de y0konad (Dan Ramos Reynaldo) — Egresado de ciberseguridad y desarrollador web en Perú. Proyectos de redes, Linux, Python, herramientas y write-ups de hacking ético.',
  path = '/',
  image = '/picture/avatars/yokonad.webp',
  type = 'website',
} = Astro.props;
const SITE = 'https://yokonad.online';
const canonical = SITE + path;
// URL absoluta de la imagen social (acepta ruta relativa o URL completa)
const ogImage = image.startsWith('http') ? image : SITE + image;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'y0konad',
  alternateName: 'Dan Ramos Reynaldo',
  url: 'https://yokonad.online/',
  image: 'https://yokonad.online/picture/avatars/yokonad.webp',
  jobTitle: 'Egresado de Ciberseguridad y Desarrollador Web',
  sameAs: ['https://github.com/y0konad', 'https://www.instagram.com/yk.nadrr/'],
};
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="y0konad, portafolio y0konad, ciberseguridad, desarrollo web, React, Python, Linux, redes, SENATI"
    />
    <meta name="author" content="y0konad" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://r2.thesportsdb.com" crossorigin />
    <link rel="dns-prefetch" href="https://r2.thesportsdb.com" />
    {path === '/' && (
      <link rel="preload" as="image" href="/picture/avatars/yokonad.webp" type="image/webp" fetchpriority="high" />
    )}
    <link rel="preload" href="/fonts/ibm-plex-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/press-start-2p-400.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/picture/logos/linux.ico" />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>
  <body class="relative min-h-screen bg-black text-slate-100 overflow-x-hidden w-full max-w-full">
    <div
      class="fixed inset-0 z-0 pointer-events-none w-full h-full overflow-hidden"
      aria-hidden="true"
      style="will-change: transform; transform: translate3d(0, 0, 0); contain: strict;"
    >
      <AsciiSharks client:only="react" />
    </div>
    <div class="relative z-10 min-h-screen w-full max-w-full overflow-x-hidden">
      <slot />
    </div>
  </body>
</html>
