<script is:inline>
  // Scramble periódico de los números de paso: cada cierto tiempo cambian a
  // caracteres aleatorios del mismo tamaño y vuelven a su número original.
  (() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const badges = Array.from(document.querySelectorAll('.mk-step-badge'));
    if (!badges.length) return;

    const GLYPHS = 'ABCDEFGHKMNPQRSTUVWXYZ0123456789#%$&';
    const rnd = () => GLYPHS[Math.floor(Math.random() * GLYPHS.length)];

    badges.forEach((b) => (b.dataset.final = b.textContent.trim()));

    function scramble(el) {
      const final = el.dataset.final;
      let frame = 0;
      const frames = 12;
      clearInterval(el._sid);
      el._sid = setInterval(() => {
        frame++;
        if (frame >= frames) {
          clearInterval(el._sid);
          el.textContent = final;
          return;
        }
        el.textContent = final.split('').map(rnd).join('');
      }, 55);
    }

    setInterval(() => {
      if (document.hidden) return;
      badges.forEach((b, i) => setTimeout(() => scramble(b), i * 130));
    }, 5000);
  })();
</script>

