---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  // Write-ups con página propia (estructura hecha a mano); se excluyen del
  // renderizado automático de esta ruta dinámica.
  const CUSTOM_PAGES = ['htb-makesense'];
  const entries = await getCollection('writeups');
  return entries
    .filter((entry) => !CUSTOM_PAGES.includes(entry.id))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const diffColor = {
  Easy: { c: '#9fef00', bg: 'rgba(159,239,0,0.14)' },
  Medium: { c: '#ffb83e', bg: 'rgba(255,184,62,0.14)' },
  Hard: { c: '#ff3e3e', bg: 'rgba(255,62,62,0.14)' },
  Insane: { c: '#ff54c7', bg: 'rgba(255,84,199,0.14)' },
};
const osColor = { Linux: '#f5b400', Windows: '#4d9fff', Otro: '#9a9aa3' };
const NAVY = '#131c2b';
const d = diffColor[entry.data.difficulty] || diffColor.Easy;
---

<Layout
  title={`${entry.data.title} · write-ups`}
  description={entry.data.summary || `Write-up de ${entry.data.title} en Hack The Box.`}
  path={`/writeups/${entry.id}/`}
  image={entry.data.icon || '/picture/avatars/yokonad.webp'}
  type="article"
>
  <div class="codex-edges codex-stack w-full py-4 sm:py-6">
    <!-- ═══════════ MASTHEAD ═══════════ -->
    <header class="flex items-center justify-between border-2 border-[var(--ink)] px-3 py-2" style={`background:${NAVY};color:var(--cream)`}>
      <a href="/writeups" class="inline-flex items-center gap-1.5 text-[9px] sm:text-[12px] font-bold tracking-[0.14em] uppercase hover:brightness-125" style="color:var(--cream)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
        Volver
      </a>
      <span class="text-[9px] sm:text-[12px] font-bold tracking-[0.14em] uppercase flex items-center gap-2 sm:gap-3">
        <span>WRITE-UPS // <span style="color:#9fef00">HTB</span></span>
        <span class="win-btns"><i></i><i></i><i></i></span>
      </span>
    </header>

    <!-- ═══════════ WRITE-UP ═══════════ -->
    <article class="border-2 border-[var(--ink)] bg-[var(--panel)]">
      <div class="win-bar" style={`background:${NAVY};color:var(--cream)`}>
        <span class="truncate">{entry.data.title}</span>
        <span class="win-btns"><i></i><i></i><i></i></span>
      </div>

      <!-- Banner de portada con la cara pixel-art (igual que makesense) -->
      <div
        class="relative h-24 sm:h-36 border-b-2 border-[var(--ink)] overflow-hidden"
        style={`background: radial-gradient(circle at 18% 25%, rgba(255,255,255,0.06), transparent 55%), repeating-linear-gradient(135deg, ${NAVY} 0px, ${NAVY} 18px, #0a0e15 18px, #0a0e15 36px);`}
      >
        <img
          src="/picture/writeups/makesense-face.png"
          alt=""
          aria-hidden="true"
          loading="eager"
          decoding="async"
          width="128"
          height="128"
          class="absolute right-3 sm:right-8 top-1/2 -translate-y-1/2 h-[128%] sm:h-[150%] w-auto pointer-events-none select-none"
          style="image-rendering:pixelated;opacity:0.55;"
        />
      </div>

      <div class="p-4 sm:p-6">
        <!-- Cabecera: icono redondo al costado del título (ya bajo el banner) -->
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-6 items-start">
          {entry.data.icon && (
            <img
              src={entry.data.icon}
              alt={entry.data.title}
              loading="eager"
              decoding="async"
              width="176"
              height="176"
              class="w-32 h-32 sm:w-44 sm:h-44 object-contain shrink-0 drop-shadow-[0_6px_16px_rgba(0,0,0,0.65)]"
            />
          )}
          <div class="min-w-0 flex-1">
            <h1 class="display text-2xl sm:text-3xl uppercase leading-none" style="color:var(--cream)">{entry.data.title}</h1>
            <div class="flex items-center gap-2 flex-wrap mt-3">
              <span class="px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide border" style={`border-color:${d.c};color:${d.c};background:${d.bg}`}>{entry.data.difficulty}</span>
              <span class="px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide border" style={`border-color:${osColor[entry.data.os] || '#9a9aa3'};color:${osColor[entry.data.os] || '#9a9aa3'}`}>{entry.data.os}</span>
              <span class="text-[9px] uppercase tracking-widest text-[var(--ink-soft)]">{entry.data.platform}</span>
              <span class="text-[9px] uppercase tracking-widest text-[var(--ink-soft)]">{entry.data.date}</span>
            </div>
            {entry.data.tags && entry.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mt-2.5">
                {entry.data.tags.map((t) => (
                  <span class="px-1.5 py-0.5 text-[8.5px] uppercase tracking-wide border border-[rgba(255,255,255,0.22)] text-[var(--ink-soft)]">{t}</span>
                ))}
              </div>
            )}
            {entry.data.summary && (
              <p class="mt-3 text-[12.5px] leading-relaxed text-[var(--ink-soft)]">{entry.data.summary}</p>
            )}
          </div>
        </div>
        <div class="wu-prose mt-6"><Content /></div>
      </div>
    </article>

    <!-- ═══════════ BARRA INFERIOR ═══════════ -->
    <footer class="flex items-center justify-between border-2 border-[var(--ink)] px-3 py-2.5" style={`background:${NAVY};color:var(--cream)`}>
      <span class="text-[9px] sm:text-[12px] font-bold tracking-[0.12em] uppercase">HACK THE BOX · WRITE-UPS</span>
      <a href="/writeups" class="inline-flex items-center gap-1.5 text-[9px] sm:text-[12px] font-bold tracking-[0.12em] uppercase hover:brightness-125" style="color:var(--cream)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
        Volver
      </a>
    </footer>
  </div>
</Layout>

<script is:inline>
  // Convierte los blockquotes marcados [FLAG:USER]/[FLAG:ROOT] en una caja de
  // bandera capturada, con su banderita pixel-art ondeante (verde/rojo).
  (() => {
    const build = (kind, color, innerHTML) => {
      const box = document.createElement('div');
      box.className = 'wu-flag';
      box.style.setProperty('--cc', color);

      const tag = document.createElement('span');
      tag.className = 'wu-flag-tag';
      tag.textContent = kind;
      if (kind === 'ROOT') { tag.style.background = color; tag.style.color = '#0a0e15'; }

      const txt = document.createElement('span');
      txt.className = 'wu-flag-txt';
      txt.innerHTML = innerHTML;

      const flag = document.createElement('span');
      flag.className = 'pxflag';
      flag.style.setProperty('--fc', color);
      flag.setAttribute('aria-hidden', 'true');
      const pole = document.createElement('span'); pole.className = 'pxflag-pole';
      const cloth = document.createElement('span'); cloth.className = 'pxflag-cloth';
      for (let i = 0; i < 7; i++) cloth.appendChild(document.createElement('i'));
      flag.appendChild(pole); flag.appendChild(cloth);

      box.appendChild(tag); box.appendChild(txt); box.appendChild(flag);
      return box;
    };

    document.querySelectorAll('.wu-prose blockquote').forEach((bq) => {
      const m = bq.textContent.match(/^\s*\[FLAG:(USER|ROOT)\]/);
      if (!m) return;
      const kind = m[1];
      const color = kind === 'USER' ? '#9fef00' : '#ff3e3e';
      const src = bq.querySelector('p') || bq;
      const html = src.innerHTML.replace(/^\s*\[FLAG:(USER|ROOT)\]\s*/, '');
      bq.replaceWith(build(kind, color, html));
    });
  })();

  // Convierte los títulos "N. Título" en un badge con el número + título, y hace
  // que los números hagan scramble periódico (mismo efecto que makesense).
  (() => {
    const heads = Array.from(document.querySelectorAll('.wu-prose h2'));
    const badges = [];
    heads.forEach((h) => {
      const m = h.textContent.match(/^\s*(\d+)\.\s*(.+)$/s);
      if (!m) return;
      h.textContent = '';
      const badge = document.createElement('span');
      badge.className = 'wu-badge';
      badge.textContent = m[1];
      const title = document.createElement('span');
      title.textContent = m[2];
      h.appendChild(badge);
      h.appendChild(title);
      badges.push(badge);
    });

    if (!badges.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const GLYPHS = 'ABCDEFGHKMNPQRSTUVWXYZ0123456789#%$&';
    const rnd = () => GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
    badges.forEach((b) => (b.dataset.final = b.textContent.trim()));

    function scramble(el) {
      const final = el.dataset.final;
      let frame = 0;
      clearInterval(el._sid);
      el._sid = setInterval(() => {
        frame++;
        if (frame >= 12) {
          clearInterval(el._sid);
          el.textContent = final;
          return;
        }
        el.textContent = final.split('').map(rnd).join('');
      }, 55);
    }

    setInterval(() => {
      if (document.hidden) return;
      badges.forEach((b, i) => setTimeout(() => scramble(b), i * 130));
    }, 5000);
  })();
</script>
