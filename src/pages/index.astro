// Canciones de la lista oficial de Spotify de y0konad (44 pistas de sus capturas)
const tracks = [
  { title: 'Khé?', artist: 'Rauw Alejandro & Romeo Santos', cover: '/picture/music/khe-rauw-alejandro.webp' },
