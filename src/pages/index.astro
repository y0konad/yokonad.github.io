---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { profile, projects, team, teamName, teamDescription, comunidad } from '../data/content.js';

// Nombres de los write-ups para la mini-terminal (se actualiza solo)
const writeupNames = (await getCollection('writeups'))
  .map((w) => w.id.replace(/^htb-/, ''))
  .sort();

const stack = [
  'Redes y subneteo — Cisco Packet Tracer',
  'Desarrollo web — React, Node.js',
  'Scripting y automatización — Python',
  'Sistemas — Windows, Arch, Fedora, Debian',
  'Ciberseguridad defensiva',
  'Proyectos open-source',
];

// Logos del carrusel con colores de marca para el glow (logos oficiales)
const techLogos = [
  { slug: 'javascript', title: 'JavaScript', color: '#F7DF1E' },
  { slug: 'react', title: 'React', color: '#61DAFB' },
  { slug: 'nodedotjs', title: 'Node.js', color: '#5FA04E' },
  { slug: 'python', title: 'Python', src: '/picture/logos/python.svg', color: '#3776AB' },
  { slug: 'css', title: 'CSS', color: '#A855F7' }, // Morado
  { slug: 'git', title: 'Git', color: '#F05032' },
  { slug: 'java', title: 'Java / OpenJDK', src: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg', color: '#E76F00' },
  { slug: 'tailwindcss', title: 'Tailwind', color: '#06B6D4' },
  { slug: 'html5', title: 'HTML', color: '#E34F26' },
  { slug: 'linux', title: 'Linux', src: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linux/linux-original.svg', color: '#FCC624' },
  { slug: 'archlinux', title: 'Arch', color: '#1793D1' },
  { slug: 'ubuntu', title: 'Ubuntu', color: '#E95420' },
  { slug: 'go', title: 'Go', color: '#00ADD8' },
  { slug: 'npm', title: 'npm', color: '#CB3837' },
  { slug: 'claude', title: 'Claude', color: '#D97757' },
  { slug: 'deepseek', title: 'DeepSeek', color: '#4D6BFE' },
];

// Reproductor de música — playlist (8 canciones)
const tracks = [
  { id: 'eJLwj6FohJo', title: 'Indiana', artist: 'Hombres G' },
  { id: 'URoY2H7VhBI', title: 'Parte del Aire', artist: 'Fito Páez' },
  { id: '6hzrDeceEKc', title: 'Wonderwall', artist: 'Oasis' },
  { id: 'tI-5uv4wryI', title: 'Champagne Supernova', artist: 'Oasis' },
  { id: 'xg_Y7Or_hWM', title: 'Last Night on Earth', artist: 'Green Day' },
  { id: 'Qy7LcH7pWZo', title: 'Díganselo', artist: 'El Kuelgue' },
  { id: 'MVeiKDh4ffk', title: 'Cada Vez Que Digo Adiós', artist: 'Los Enanitos Verdes' },
  { id: 'ZjZecW1BvZE', title: 'Mi Primer Día Sin Ti', artist: 'Los Enanitos Verdes' },
];

// Iconos para las tarjetas de contacto
const linkConfig = {
  GitHub: {
    path: 'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z',
  },
  Instagram: {
    path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z',
  },
  Discord: {
    path: 'M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z',
  },
  Gmail: {
    path: 'M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z',
  },
};

// Colores por lenguaje/etiqueta del equipo y proyectos (Medio Morado Oscuro)
const tagColors = {
  Python: { border: 'rgba(147,51,234,0.4)', bg: 'rgba(88,28,135,0.25)', text: '#d8b4fe' },
  Android: { border: 'rgba(168,85,247,0.4)', bg: 'rgba(107,33,168,0.25)', text: '#e9d5ff' },
  Streaming: { border: 'rgba(147,51,234,0.4)', bg: 'rgba(88,28,135,0.25)', text: '#d8b4fe' },
  Frontend: { border: 'rgba(168,85,247,0.4)', bg: 'rgba(107,33,168,0.25)', text: '#e9d5ff' },
  'UI/UX': { border: 'rgba(147,51,234,0.4)', bg: 'rgba(88,28,135,0.25)', text: '#d8b4fe' },
  Cisco: { border: 'rgba(126,34,206,0.4)', bg: 'rgba(88,28,135,0.25)', text: '#c084fc' },
  HTML: { border: 'rgba(168,85,247,0.4)', bg: 'rgba(107,33,168,0.25)', text: '#e9d5ff' },
  JavaScript: { border: 'rgba(147,51,234,0.4)', bg: 'rgba(88,28,135,0.25)', text: '#d8b4fe' },
  Networking: { border: 'rgba(126,34,206,0.4)', bg: 'rgba(88,28,135,0.25)', text: '#c084fc' },
  CLI: { border: 'rgba(147,51,234,0.4)', bg: 'rgba(88,28,135,0.25)', text: '#d8b4fe' },
  TypeScript: { border: 'rgba(168,85,247,0.4)', bg: 'rgba(107,33,168,0.25)', text: '#e9d5ff' },
  'Node.js': { border: 'rgba(147,51,234,0.4)', bg: 'rgba(88,28,135,0.25)', text: '#d8b4fe' },
  MCP: { border: 'rgba(192,132,252,0.4)', bg: 'rgba(126,34,206,0.25)', text: '#f3e8ff' },
  'Packet Tracer': { border: 'rgba(126,34,206,0.4)', bg: 'rgba(88,28,135,0.25)', text: '#c084fc' },
  Electrónica: { border: 'rgba(147,51,234,0.4)', bg: 'rgba(88,28,135,0.25)', text: '#d8b4fe' },
};

const tagStyle = (t) => {
  const c = tagColors[t];
  return c
    ? `border:1px solid ${c.border};background:${c.bg};color:${c.text}`
    : 'border:1px solid rgba(255,255,255,0.1);color:#94a3b8';
};
---

<Layout>
  <div id="top" class="codex-edges codex-stack w-full py-4 sm:py-6">
    <!-- ═══════════ MASTHEAD ═══════════ -->
    <header class="flex items-center justify-between rounded-[2px] border border-white/5 bg-[#040711]/95 px-3 sm:px-4 py-2.5 text-slate-200">
      <span class="text-[10px] sm:text-[12px] font-semibold tracking-[0.14em] uppercase text-slate-300 font-mono flex items-center gap-2">
        <span class="inline-block w-1.5 h-1.5 rounded-[1px] bg-purple-400"></span>
        // y0konad
      </span>
      <span class="flex items-center gap-2 sm:gap-3 text-[10px] sm:text-[12px] font-medium tracking-[0.14em] uppercase">
        <span id="codex-clock" class="hidden sm:inline tabular-nums text-slate-400 font-mono">--:--:--</span>
      </span>
    </header>

    <!-- ═══════════ 1 · TÍTULO / HERO ═══════════ -->
    <section>
      <div class="inline-flex items-center gap-2 text-[10px] sm:text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-300 bg-[#040711] border border-white/5 px-3 py-1 rounded-[2px] mb-3 font-mono">
        <span class="inline-block w-1.5 h-1.5 rounded-[1px] bg-purple-400"></span>
        // Perú · Ciberseguridad & Desarrollo
      </div>
      <div class="flex flex-col lg:flex-row lg:items-end gap-5 lg:gap-8">
        <div class="lg:flex-1 min-w-0 lg:self-start">
          <h1 class="display uppercase leading-[0.84] text-white tracking-tight">
            <span class="scramble block text-[clamp(2.6rem,11vw,5.6rem)]">Desde</span>
            <span class="scramble block text-[clamp(2.6rem,11vw,5.6rem)]">Mi</span>
            <span id="hero-l3" class="scramble block text-[clamp(2.6rem,11vw,5.6rem)] text-white">Terminal</span>
          </h1>
          <p class="mt-4 text-[13px] sm:text-[14px] leading-relaxed text-slate-300 max-w-2xl font-mono">
            Ciberseguridad, redes y código desde Perú. Un recorrido por proyectos y la comunidad que
            construyo en el camino. Entre terminales, Linux y buena música, documento lo que aprendo y
            comparto cada paso del proceso.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════ 2 · PERFIL ═══════════ -->
    <section class="space-y-4">
      <div class="section-label">// Perfil</div>

      <!-- Presentación con avatar -->
      <div class="win">
        <div class="win-bar is-ink">
          <span class="scramble text-slate-200">Perfil // y0konad</span>
          <span class="text-[9px] text-slate-400 font-mono">[Online]</span>
        </div>
        <div class="p-4 sm:p-5 grid gap-5 sm:grid-cols-[auto_1fr] items-start">
          <!-- Avatar grande -->
          <div class="relative mx-auto sm:mx-0 shrink-0">
            <img
              src={profile.avatar}
              alt="y0konad"
              loading="eager"
              class="w-44 h-52 sm:w-48 sm:h-60 object-cover rounded-[2px] border border-white/5"
            />
            <span class="absolute -bottom-2.5 left-2 inline-flex items-center gap-1.5 bg-[#020408] border border-white/10 text-slate-200 text-[9px] font-semibold uppercase tracking-widest px-2.5 py-1 rounded-[2px] font-mono">
              <span class="w-1.5 h-1.5 rounded-[1px] bg-purple-400"></span>
              Disponible
            </span>
          </div>

          <!-- Info -->
          <div class="min-w-0">
            <p class="display text-3xl sm:text-4xl text-white lowercase leading-none">y0konad</p>
            <p class="text-[11px] uppercase tracking-[0.2em] text-slate-300 mt-2.5 font-mono">Dan Ramos Reynaldo</p>
            <p class="text-[12px] text-slate-300 mt-0.5 font-mono font-medium">Egresado de Ciberseguridad</p>
            <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[10px] text-slate-400 font-mono">
              <span>◈ {profile.location}</span>
              <span>◈ SENATI · Egresado</span>
              <span>◈ Redes · Linux · Web</span>
            </div>
            <p class="mt-3 text-[12.5px] leading-relaxed text-slate-300">
              Lo que empezó como curiosidad por entender cómo funcionan las máquinas, hoy se
              convirtió en proyectos, retos y comunidad.
            </p>

            <!-- Ficha de datos -->
            <div class="mt-4 border-t border-white/5 pt-3.5 grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-2 font-mono">
              {
                [
                  ['Apodo', 'y0konad'],
                  ['Ubicación', 'Perú'],
                  ['Estudios', 'Ciberseguridad · SENATI'],
                  ['Condición', 'Egresado'],
                  ['Enfoque', 'Seguridad defensiva'],
                  ['Intereses', 'Anime · Música'],
                  ['Combustible', 'Código & café'],
                  ['Estado', 'Disponible'],
                ].map(([k, v]) => (
                  <div class="flex gap-2 text-[11px] items-center">
                    <span class="text-slate-400 uppercase tracking-wider text-[9px] w-24 shrink-0">{k}</span>
                    <span class="flex-1 font-medium text-slate-200">{v}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Sobre mí + Stack -->
      <div class="grid gap-4 md:grid-cols-2">
        <div class="win">
          <div class="win-bar"><span class="scramble">Sobre mí</span></div>
          <div class="p-4 text-[12px] leading-relaxed text-slate-300 font-mono">
            <p class="mb-3">Este portafolio existe como un espacio para aprender, construir y compartir.</p>
            <ul class="space-y-2">
              <li class="diamond text-slate-200">Egresado de Ciberseguridad — SENATI</li>
              <li class="diamond text-slate-200">Redes, Linux y desarrollo web</li>
              <li class="diamond text-slate-200">La música como combustible diario</li>
            </ul>
            <p class="mt-3 text-slate-400 italic font-mono text-[11px]">Aprendiendo algo nuevo cada día.</p>
          </div>
        </div>

        <div class="win">
          <div class="win-bar is-ink">
            <span class="scramble">Stack técnico</span>
            <span class="text-[9px] text-slate-400 font-mono">[6 ITEMS]</span>
          </div>
          <ul class="p-4 text-[11.5px] leading-relaxed space-y-1.5 font-mono text-slate-300">
            {stack.map((s) => (
              <li class="flex items-center gap-2">
                <span class="text-purple-400 font-bold">&gt;</span> {s}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Carrusel de logos de lenguajes / tecnologías -->
      <div class="logoloop" role="region" aria-label="Lenguajes y tecnologías">
        <div class="logoloop__track">
          {
            [...techLogos, ...techLogos].map((l, i) => (
              <span
                class="logoloop__item"
                title={l.title || l.text}
                aria-hidden={i >= techLogos.length ? 'true' : undefined}
                style={`--glow: ${l.color || '#9fef00'}`}
              >
                {l.src || l.slug ? (
                  <img
                    src={l.src || `https://cdn.simpleicons.org/${l.slug}`}
                    alt={l.title}
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                    width="40"
                    height="40"
                  />
                ) : (
                  <span class="logoloop__chip">{l.text}</span>
                )}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ═══════════ 3 · PROYECTOS ═══════════ -->
    <section class="space-y-4">
      <div class="section-label">// Proyectos</div>
      <div class="grid gap-3 sm:grid-cols-3">
        {
          projects.map((p) => (
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="win flex flex-col group">
              <div class="win-bar is-ink">
                <span class="scramble text-slate-200">{p.title}</span>
                <span class="text-[9px] text-slate-400 font-mono">[Open Source]</span>
              </div>
              <div class="p-3.5 flex-1 flex flex-col font-mono">
                <p class="text-[11.5px] leading-snug text-slate-300 flex-1">{p.description}</p>
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {p.tags.map((t) => (
                    <span class="px-2 py-0.5 text-[9px] uppercase tracking-wide font-semibold rounded-[2px]" style={tagStyle(t)}>
                      {t}
                    </span>
                  ))}
                </div>
                <span class="mt-3 text-[11px] font-bold text-purple-400 group-hover:text-purple-300 flex items-center gap-1">
                  Ver en GitHub →
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ═══════════ 4 · HACK THE BOX ═══════════ -->
    <section class="space-y-4">
      <div class="section-label">// Hack The Box</div>
      <div class="grid gap-3 md:grid-cols-2">
        <!-- Perfil HTB (toda la tarjeta es enlace) -->
        <a
          href="https://app.hackthebox.com/users/2072316"
          target="_blank"
          rel="noopener noreferrer"
          class="win overflow-hidden flex flex-col group"
        >
          <div class="win-bar is-ink">
            <span class="scramble text-slate-200">Hack The Box // Perfil</span>
            <span class="text-[9px] text-slate-400 font-mono">[ID: 2072316]</span>
          </div>
          <div class="w-full h-40 flex items-center justify-center border-b border-white/5 p-4 bg-[#050911]">
            <img src="/picture/logos/logo_htb.webp" alt="Hack The Box" loading="lazy" class="max-h-24 w-auto object-contain" />
          </div>
          <div class="p-4 text-[12.5px] leading-relaxed flex flex-col flex-1 font-mono">
            <p class="mb-3 text-slate-300 flex-1">Mi perfil en <span class="hl" style="background:rgba(159,239,0,0.12);color:#9fef00;border-bottom:1px solid rgba(159,239,0,0.3)">Hack The Box</span>: máquinas comprometidas, retos y progreso en hacking ético.</p>
            <span class="bar-title bar-title--htb">▸ Ver perfil HTB</span>
          </div>
        </a>

        <!-- Write-ups (toda la tarjeta es enlace) -->
        <a
          href="/writeups"
          class="win overflow-hidden flex flex-col group"
        >
          <div class="win-bar" style="background:#000;color:#9fef00">
            <span class="scramble">Write-ups // Terminal</span>
            <span class="text-[9px] text-[#9fef00]/80 font-mono">[Archivos]</span>
          </div>
          <div class="w-full h-40 border-b border-white/5 p-4 font-mono text-[12px] leading-[1.55] overflow-hidden" style="background:#000">
            <div><span style="color:#64748b">y0konad@htb</span>:<span style="color:#38bdf8">~</span>$ <span style="color:#9fef00">whoami</span></div>
            <div style="color:#f8fafc">y0konad</div>
            <div><span style="color:#64748b">y0konad@htb</span>:<span style="color:#38bdf8">~</span>$ <span style="color:#9fef00">ls</span> ~/writeups</div>
            <div style="color:#38bdf8">{writeupNames.join('  ')}</div>
            <div><span style="color:#64748b">y0konad@htb</span>:<span style="color:#38bdf8">~</span>$ <span class="term-cursor"></span></div>
          </div>
          <div class="p-4 text-[12.5px] leading-relaxed flex flex-col flex-1 font-mono">
            <p class="mb-3 text-slate-300 flex-1">Mis <span class="hl" style="background:rgba(159,239,0,0.12);color:#9fef00;border-bottom:1px solid rgba(159,239,0,0.3)">write-ups</span> de máquinas y retos: reconocimiento, explotación y escalada de privilegios.</p>
            <span class="bar-title bar-title--htb">▸ Ver write-ups</span>
          </div>
        </a>
      </div>
    </section>

    <!-- ═══════════ 5 · ACTIVIDAD · GITHUB ═══════════ -->
    <section class="space-y-4">
      <div class="section-label">// Actividad en GitHub</div>
      <div class="grid gap-3 md:grid-cols-[4fr_1fr]">
        <div class="win">
          <div class="win-bar is-ink">
            <span class="scramble text-slate-200">GitHub // y0konad</span>
            <span class="text-[9px] text-slate-400 font-mono">[Live]</span>
          </div>
          <div class="p-3.5">
            <div class="flex items-center justify-between mb-3 border-b border-white/5 pb-2">
              <a href="https://github.com/y0konad" target="_blank" rel="noopener noreferrer" class="text-[11px] font-bold uppercase tracking-widest text-white hover:text-[#39d353] flex items-center gap-1.5 transition-colors font-mono">
                <span class="text-[#39d353]">&gt;</span> y0konad
              </a>
              <span id="gh-total" class="text-[11px] text-slate-300 font-mono font-medium tabular-nums">Cargando datos…</span>
            </div>
