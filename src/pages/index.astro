  { title: 'Dar es dar', artist: 'Fito Páez', cover: '/picture/music/dar-es-dar.webp' },
  { title: 'Loco', artist: 'Andrés Calamaro', cover: '/picture/music/loco-calamaro.webp' },
  { title: '505', artist: 'Arctic Monkeys', cover: '/picture/music/505-arctic-monkeys.webp' },
  { title: 'Problemón', artist: 'Álvaro Díaz & Rauw Alejandro', cover: '/picture/music/problemon.webp' },
  { title: '220', artist: 'Dillom', cover: '/picture/music/220-dillom.webp' },
