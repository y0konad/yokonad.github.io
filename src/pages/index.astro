  { title: 'SLOW DANCING IN THE DARK', artist: 'Joji', cover: '/picture/music/slow-dancing-in-the-dark.webp' },
  { title: 'Please Please Please', artist: 'Sabrina Carpenter', cover: '/picture/music/please-please-please.webp' },
