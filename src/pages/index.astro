  <script is:inline>
    // Pausa temporizadores/animaciones cuando su sección NO está en pantalla.
    // Evita que ~9 bucles corran a la vez todo el tiempo (fluidez, sobre todo en móvil).
    function onVisible(el, onIn, onOut) {
      if (!el) return;
      if (!('IntersectionObserver' in window)) { if (onIn) onIn(); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { if (onIn) onIn(); } else { if (onOut) onOut(); }
        });
      }, { threshold: 0, rootMargin: '150px' });
      io.observe(el);
    }

    (function () {
      var clock = document.getElementById('codex-clock');
      if (clock) {
        var pad = function (n) { return String(n).padStart(2, '0'); };
        var tick = function () {
          var d = new Date();
          clock.textContent = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
        };
        tick();
        setInterval(tick, 1000);
      }

      var CH = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      function scramble(el) {
        var target = el.getAttribute('data-text');
        if (target === null) { target = el.textContent; el.setAttribute('data-text', target); }
        var q = [];
        for (var i = 0; i < target.length; i++) {
          q.push({ c: target[i], to: 8 + Math.floor(Math.random() * 26) });
        }
        var frame = 0;
        function update() {
          var out = '', done = 0;
          for (var i = 0; i < q.length; i++) {
            if (frame >= q[i].to) { out += q[i].c; done++; }
            else if (q[i].c === ' ') { out += ' '; done++; }
            else {
              if (!q[i].r || Math.random() < 0.3) q[i].r = CH[Math.floor(Math.random() * CH.length)];
              out += '<span class="scr-dim">' + q[i].r + '</span>';
            }
          }
          el.innerHTML = out;
          if (done === q.length) { el.textContent = target; return; }
          frame++;
          requestAnimationFrame(update);
        }
        update();
      }

      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var titles = document.querySelectorAll('.scramble');

      // El observer solo dispara el scramble de los títulos cuando entran en pantalla.
      if (reduce || !('IntersectionObserver' in window)) { return; }

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          scramble(e.target);
          io.unobserve(e.target);
        });
      }, { threshold: 0.25 });

      titles.forEach(function (el) { io.observe(el); });
    })();

    // ── Contador de ciberataques en vivo ──
    (function () {
      var el = document.getElementById('cyber-count');
      if (!el) return;
      var BASE = Date.UTC(2026, 0, 1) / 1000;
      var RATE = 2200;
      function up() { el.textContent = Math.floor((Date.now() / 1000 - BASE) * RATE).toLocaleString('en-US'); }
      up();
      var timer = null;
      onVisible(el,
        function () { if (!timer) { up(); timer = setInterval(up, 80); } },
        function () { if (timer) { clearInterval(timer); timer = null; } });
    })();

    // ── Tiempo sin nuevo capítulo (Go-Tōbun no Hanayome) ──
    (function () {
      var el = document.getElementById('quint');
      if (!el) return;
      var L = new Date('2020-02-19T00:00:00Z');
      var labels = ['años', 'meses', 'días', 'hrs', 'min', 'seg'];
      function pad(n) { return String(n).padStart(2, '0'); }
      function up() {
        var now = new Date();
        var Y = now.getFullYear() - L.getFullYear();
        var Mo = now.getMonth() - L.getMonth();
        var D = now.getDate() - L.getDate();
        var H = now.getHours() - L.getHours();
        var Mi = now.getMinutes() - L.getMinutes();
        var S = now.getSeconds() - L.getSeconds();
        if (S < 0) { S += 60; Mi--; }
        if (Mi < 0) { Mi += 60; H--; }
        if (H < 0) { H += 24; D--; }
        if (D < 0) { D += new Date(now.getFullYear(), now.getMonth(), 0).getDate(); Mo--; }
        if (Mo < 0) { Mo += 12; Y--; }
        var vals = [Y, Mo, D, pad(H), pad(Mi), pad(S)];
        var html = '';
        for (var i = 0; i < 6; i++) {
          html += '<div class="text-center"><span class="block text-base sm:text-lg font-bold leading-none text-sky-400">' + vals[i] + '</span><span class="text-[7px] uppercase tracking-widest text-slate-400">' + labels[i] + '</span></div>';
          if (i < 5) html += '<span class="text-sm leading-none text-slate-500">:</span>';
        }
        el.innerHTML = html;
      }
      up();
      var qt = null;
      onVisible(el,
        function () { if (!qt) { up(); qt = setInterval(up, 1000); } },
        function () { if (qt) { clearInterval(qt); qt = null; } });
    })();

    // ── Último partido del FC Barcelona (Carga diferida al estar visible con timeout seguro) ──
    (function () {
      var box = document.getElementById('barca');
      if (!box) return;
      var fetched = false;

      function loadMatch() {
        if (fetched) return;
        fetched = true;

        var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
        var timeoutId = controller ? setTimeout(function () { controller.abort(); }, 5000) : null;

        fetch('https://www.thesportsdb.com/api/v1/json/3/eventslast.php?id=133739', {
          signal: controller ? controller.signal : undefined
        })
          .then(function (r) {
            if (timeoutId) clearTimeout(timeoutId);
            return r.json();
          })
          .then(function (data) {
            var m = data.results && data.results[0];
            if (!m) { box.innerHTML = '<span class="text-[11px] text-slate-400 font-mono">[Sin datos]</span>'; return; }
            var badge = function (url) {
              return url
                ? '<img src="' + url + '" alt="" width="32" height="32" loading="lazy" decoding="async" class="w-8 h-8 object-contain"/>'
                : '';
            };
            box.innerHTML =
              '<div class="flex items-center gap-3 my-1">' +
              '<div class="flex flex-col items-center gap-1">' + badge(m.strHomeTeamBadge) + '<span class="text-[9px] uppercase tracking-widest font-bold text-white">' + m.strHomeTeam + '</span></div>' +
              '<div class="flex items-center gap-2"><span class="text-2xl font-bold text-sky-400">' + (m.intHomeScore || 0) + '</span><span class="text-lg text-slate-400">-</span><span class="text-2xl font-bold text-sky-400">' + (m.intAwayScore || 0) + '</span></div>' +
              '<div class="flex flex-col items-center gap-1">' + badge(m.strAwayTeamBadge) + '<span class="text-[9px] uppercase tracking-widest font-bold text-white">' + m.strAwayTeam + '</span></div>' +
              '</div>' +
              '<span class="text-[8px] text-slate-400">' + (m.strVenue || '') + ' — ' + (m.strStatus || 'FT') + '</span>';
          })
          .catch(function () {
            if (timeoutId) clearTimeout(timeoutId);
            box.innerHTML = '<span class="text-[11px] text-slate-400 font-mono">[Sin datos]</span>';
          });
      }

      onVisible(box, loadMatch);
    })();

    // ── Cita: frases reflexivas que rotan con scramble (en bucle) ──
    (function () {
      var el = document.getElementById('cita-frase');
      if (!el) return;
      var phrases = [
        'ENTENDER ES MÁS FUERTE QUE TEMER.',
        'LAS REDES CONECTAN MÁS QUE MÁQUINAS.',
        'CADA ERROR ES UNA LÍNEA HACIA LA SOLUCIÓN.',
        'EL CÓDIGO ABIERTO CONSTRUYE COMUNIDAD.',
        'EL CONOCIMIENTO SE COMPARTE, NO SE ACAPARA.'
      ];
      var CH = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      var HOLD = 4000; // ms que se mantiene cada frase
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var idx = 0;

      function scrambleTo(text, cb) {
        if (reduce) { el.textContent = text; if (cb) setTimeout(cb, HOLD); return; }
        var q = [];
        for (var i = 0; i < text.length; i++) {
          q.push({ c: text[i], to: 6 + Math.floor(Math.random() * 22) });
        }
        var frame = 0;
        function update() {
          var out = '', done = 0;
          for (var i = 0; i < q.length; i++) {
            if (frame >= q[i].to) { out += q[i].c; done++; }
            else if (q[i].c === ' ') { out += ' '; done++; }
            else {
              if (!q[i].r || Math.random() < 0.3) q[i].r = CH[Math.floor(Math.random() * CH.length)];
              out += '<span class="scr-dim">' + q[i].r + '</span>';
            }
          }
          el.innerHTML = out;
          if (done === q.length) { el.textContent = text; if (cb) cb(); return; }
          frame++;
          requestAnimationFrame(update);
        }
        update();
      }

      function cycle() {
        scrambleTo(phrases[idx], function () {
          setTimeout(function () {
            idx = (idx + 1) % phrases.length;
            cycle();
          }, HOLD);
        });
      }
      cycle();
    })();
  </script>
</Layout>
